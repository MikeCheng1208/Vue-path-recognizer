{
  "name": "vue-path-recognizer",
  "version": "2.0.0",
  "description": "Path recognizing component for Vue",
  "main": "./dist/vue-path-recognizer.umd.js",
  "module": "./dist/vue-path-recognizer.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue-path-recognizer.es.js",
      "require": "./dist/vue-path-recognizer.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest",
    "preview": "vite preview",
    "push": "git push && npm publish",
    "example:dev": "cd example && npm run dev",
    "example:build": "cd example && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeCheng1208/Vue-path-recognizer.git"
  },
  "keywords": [
    "vue",
    "javascript"
  ],
  "author": "mike cheng <https://github.com/MikeCheng1208/> (https://github.com/MikeCheng1208/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MikeCheng1208/Vue-path-recognizer/issues"
  },
  "homepage": "https://github.com/MikeCheng1208/Vue-path-recognizer",
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^21.1.2",
    "npm": "^10.2.4",
    "npm-run-all": "^4.1.5",
    "vite": "^4.5.14",
    "vitest": "^0.28.5",
    "vue": "^3.5.21"
  },
  "directories": {
    "example": "example"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}
